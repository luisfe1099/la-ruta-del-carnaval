# Número de WhatsApp en formato internacional, solo dígitos (Colombia = 57).
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000

# URL pública del sitio (metadatos, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origen del contenido: "sample" (datos locales) o "sanity".
CONTENT_SOURCE=sample

# Solo si CONTENT_SOURCE=sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=

# Solo con CONTENT_SOURCE=sanity. Usa un dataset PRIVADO + token de lectura
# (solo servidor): así la ubicación exacta de talleres privados no es consultable públicamente.
SANITY_API_READ_TOKEN=
